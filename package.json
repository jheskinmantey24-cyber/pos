{
  "name": "jeskin-pos",
  "version": "1.0.0",
  "description": "JESKIN POS System for small businesses",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "init-db": "node scripts/init-db.js",
    "create-admin": "node scripts/create-admin.js",
    "backup": "node scripts/backup-db.js",
    "healthcheck": "node -e \"fetch('http://localhost:3000/api/health').then(r => r.json()).then(d => { console.log(JSON.stringify(d)); process.exit(d.status === 'ok' ? 0 : 1); }).catch(err => { console.error(err.message); process.exit(1); });\"",
    "start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-pos.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File scripts/stop-pos.ps1"
  },
  "keywords": [
    "pos",
    "express",
    "mysql",
    "retail"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.4.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
