# --- Aiven MySQL values for Render (set these in the Render dashboard, never commit them) ---
# NODE_ENV=production
# DB_HOST=<your-service-host>.aivencloud.com
# DB_PORT=<service port, e.g. 12345>
# DB_USER=avnadmin
# DB_PASSWORD=<service password>
# DB_NAME=defaultdb
# JWT_SECRET=<random 32+ character secret>
# JWT_EXPIRES_IN=8h
# CORS_ORIGIN=https://<your-render-service>.onrender.com
# DB_SSL_CA=ca.pem              (optional; defaults to ca.pem in the project root)
# DB_CONNECTION_LIMIT=10        (optional, matches Aiven small plans)
